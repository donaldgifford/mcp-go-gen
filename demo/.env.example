# IMPL-0002 demo env. Copy to demo/.env (gitignored) and edit.
#
# `make demo-up` reads demo/.env via compose. The same string is shared
# between demo-api (validates against requests) and demo-mcp (sends in
# the upstream Authorization header). Phase 1b (boundary bearer auth on
# the MCP itself) adds MCP_BOUNDARY_TOKEN here.

# The single bearer token /api/bearer/* expects.
DEMO_BEARER_TOKEN=demo-secret-please-change

# Optional override — defaults to DEMO_BEARER_TOKEN above. Use a
# different value here if you want to verify demo-mcp authenticates to
# demo-api with a distinct token.
# MCP_DEMO_API_TOKEN=

# slog level for demo-api: debug | info | warn | error
DEMO_LOG_LEVEL=info

# Phase 1b: MCP boundary auth. The inspector must send
# `Authorization: Bearer <MCP_BOUNDARY_TOKEN>` (UI-paste, not env) to
# reach the MCP server's tools list and call any tool. The MCP server
# itself reads this from env and accepts that one value. Distinct from
# DEMO_BEARER_TOKEN so the two perimeters can rotate independently.
MCP_BOUNDARY_TOKEN=mcp-boundary-secret-please-change

# Phase 5 (IMPL-0002): demo-idp issuer + audience. Defaults match the
# compose service's internal DNS name; override only if you publish
# demo-idp differently (e.g. behind a reverse proxy at a public URL).
# IDP_ISSUER=http://demo-idp:5556
# IDP_AUDIENCE=mcp-demo-api

# Phase 5: static service-account JWT the MCP forwards to /api/oauth2flow.
# Mint via `make demo-mint-service-token` after `make demo-up` (demo-idp
# must be running). Empty by default — Phase 1–4 flows do not need it.
MCP_OAUTH2_SERVICE_TOKEN=
