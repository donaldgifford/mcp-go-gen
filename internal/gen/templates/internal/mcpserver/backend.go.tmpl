{{/* Emitted only when spec.Proxy is non-nil. */ -}}
package mcpserver

import (
	"net/http"
	"net/url"
	{{if .Proxy.Bearer}}"os"
	{{end}}"strings"
	"time"
)

// Backend is the HTTP client proxy tools use to reach the upstream service.
// Phase 3 MVP: minimum useful client; retry, timeouts, and per-tool
// marshaling expand in follow-up commits.
type Backend struct {
	BaseURL string
	Token   string
	Client  *http.Client
}

// NewBackend wires a timeouts-respecting http.Client from the HCL-configured
// values. When the bearer token env var is unset, an empty string is used —
// the caller is expected to handle upstream 401s via on_error rules.
func NewBackend() *Backend {
	return &Backend{
		BaseURL: {{printf "%q" .Proxy.BaseURL}},
		{{if .Proxy.Bearer}}Token:   os.Getenv({{printf "%q" .Proxy.Bearer.TokenEnv}}),{{end}}
		Client: &http.Client{
			Timeout: {{if .Proxy.TotalTimeout}}{{.Proxy.TotalTimeout.Nanoseconds}} * time.Nanosecond{{else}}30 * time.Second{{end}},
		},
	}
}

// SubstitutePath replaces {name} placeholders in template with their values
// from params. Each value is URL-path-escaped before substitution so callers
// don't have to think about it. Centralizes the escaping rule per
// IMPL-0002 Phase 2 follow-up; callers used to inline strings.NewReplacer
// at template-emit time.
func (b *Backend) SubstitutePath(template string, params map[string]string) string {
	if len(params) == 0 {
		return template
	}
	pairs := make([]string, 0, len(params)*2)
	for name, value := range params {
		pairs = append(pairs, "{"+name+"}", url.PathEscape(value))
	}
	return strings.NewReplacer(pairs...).Replace(template)
}
