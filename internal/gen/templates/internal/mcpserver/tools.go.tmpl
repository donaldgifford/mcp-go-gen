
package mcpserver

import (
	"context"
	{{if .HasBodyTools}}"bytes"
	"encoding/json"
	{{end}}{{if .Proxy}}"fmt"
	"io"
	"net/http"
	"net/url"
	"strings"
	{{end}}"log/slog"
	"time"

	"{{.ModulePath}}/internal/mcpauth"
	"{{.ModulePath}}/internal/observability"

	"github.com/mark3labs/mcp-go/mcp"
	"go.opentelemetry.io/otel/attribute"
)

// Tools owns every tool handler. A pointer receiver is used so the MCP
// server can keep a single handle and call methods by name via AddTool.
type Tools struct {
	Metrics *observability.Metrics
	Tracer  observability.Tracer
	{{if .Proxy}}Backend *Backend{{end}}
}

{{range $tool := .Tools}}

// {{goIdent $tool.Name}} implements the "{{$tool.Name}}" tool. Handler shape
// mirrors docs/guide/mcp-server-in-go.md §11 — span, subject attribution,
// input parse, backend call, outcome metric, structured log.
func (t *Tools) {{goIdent $tool.Name}}(ctx context.Context, req mcp.CallToolRequest) (*mcp.CallToolResult, error) {
	start := time.Now()
	subj, _ := mcpauth.SubjectFromContext(ctx)

	ctx, span := t.Tracer.Start(ctx, "mcp.tool.{{$tool.Name}}")
	defer span.End()
	span.SetAttributes(attribute.String("mcp.subject", subj.Name))

	{{range $tool.Inputs -}}
	{{if .Required -}}
	{{.Name}}, err := req.RequireString({{printf "%q" .Name}})
	if err != nil {
		t.recordOutcome({{printf "%q" $tool.Name}}, subj.Name, "bad_input", start)
		return mcp.NewToolResultError(err.Error()), nil
	}
	_ = {{.Name}}
	{{else -}}
	{{.Name}} := req.GetString({{printf "%q" .Name}}, "")
	_ = {{.Name}}
	{{end -}}
	{{end}}

	{{if $tool.Backend -}}
	rawPath := strings.NewReplacer(
		{{range $p := $tool.Backend.PathParams}}{{printf "%q" (printf "{%s}" $p.Name)}}, url.PathEscape({{$p.From}}),
		{{end}}
	).Replace({{printf "%q" $tool.Backend.Path}})

	u, err := url.Parse(t.Backend.BaseURL + rawPath)
	if err != nil {
		t.recordOutcome({{printf "%q" $tool.Name}}, subj.Name, "bad_input", start)
		return mcp.NewToolResultError(fmt.Sprintf("build url: %v", err)), nil
	}

	{{if $tool.Backend.QueryParams -}}
	q := u.Query()
	{{range $p := $tool.Backend.QueryParams}}q.Set({{printf "%q" $p.Name}}, {{$p.From}})
	{{end -}}
	u.RawQuery = q.Encode()
	{{end}}

	{{if $tool.Backend.BodyParams -}}
	args := req.GetArguments()
	bodyMap := make(map[string]any, {{len $tool.Backend.BodyParams}})
	{{range $p := $tool.Backend.BodyParams -}}
	if v, ok := args[{{printf "%q" $p.From}}]; ok {
		bodyMap[{{printf "%q" $p.Name}}] = v
	}
	{{end -}}
	bodyBytes, err := json.Marshal(bodyMap)
	if err != nil {
		t.recordOutcome({{printf "%q" $tool.Name}}, subj.Name, "bad_input", start)
		return mcp.NewToolResultError(fmt.Sprintf("marshal body: %v", err)), nil
	}
	httpReq, err := http.NewRequestWithContext(ctx, {{printf "%q" $tool.Backend.Method}}, u.String(), bytes.NewReader(bodyBytes))
	{{- else}}
	httpReq, err := http.NewRequestWithContext(ctx, {{printf "%q" $tool.Backend.Method}}, u.String(), nil)
	{{- end}}
	if err != nil {
		t.recordOutcome({{printf "%q" $tool.Name}}, subj.Name, "network_error", start)
		return mcp.NewToolResultError(fmt.Sprintf("build request: %v", err)), nil
	}

	{{if $tool.Backend.BodyParams -}}
	httpReq.Header.Set("Content-Type", "application/json")
	{{end -}}
	{{range $p := $tool.Backend.HeaderParams}}httpReq.Header.Set({{printf "%q" $p.Name}}, {{$p.From}})
	{{end -}}
	if t.Backend.Token != "" {
		httpReq.Header.Set("Authorization", "Bearer "+t.Backend.Token)
	}

	resp, err := t.Backend.Client.Do(httpReq)
	if err != nil {
		t.recordOutcome({{printf "%q" $tool.Name}}, subj.Name, "network_error", start)
		slog.WarnContext(ctx, "mcp tool upstream call failed",
			"tool", {{printf "%q" $tool.Name}},
			"mcp.subject", subj.Name,
			"outcome", "network_error",
			"duration_ms", time.Since(start).Milliseconds(),
			"err", err.Error())
		return mcp.NewToolResultError(fmt.Sprintf("upstream request failed: %v", err)), nil
	}
	defer func() { _ = resp.Body.Close() }()

	body, err := io.ReadAll(io.LimitReader(resp.Body, 1<<20))
	if err != nil {
		t.recordOutcome({{printf "%q" $tool.Name}}, subj.Name, "network_error", start)
		return mcp.NewToolResultError(fmt.Sprintf("read response: %v", err)), nil
	}

	switch {
	case resp.StatusCode >= 200 && resp.StatusCode < 300:
		t.recordOutcome({{printf "%q" $tool.Name}}, subj.Name, "success", start)
		slog.InfoContext(ctx, "mcp tool completed",
			"tool", {{printf "%q" $tool.Name}},
			"mcp.subject", subj.Name,
			"outcome", "success",
			"duration_ms", time.Since(start).Milliseconds())
		return mcp.NewToolResultText(string(body)), nil
	case resp.StatusCode >= 400 && resp.StatusCode < 500:
		t.recordOutcome({{printf "%q" $tool.Name}}, subj.Name, "upstream_4xx", start)
		return mcp.NewToolResultError(fmt.Sprintf("upstream %d: %s", resp.StatusCode, string(body))), nil
	default:
		t.recordOutcome({{printf "%q" $tool.Name}}, subj.Name, "upstream_5xx", start)
		return mcp.NewToolResultError(fmt.Sprintf("upstream %d: %s", resp.StatusCode, string(body))), nil
	}
	{{- else}}
	t.recordOutcome({{printf "%q" $tool.Name}}, subj.Name, "success", start)
	slog.InfoContext(ctx, "mcp tool completed",
		"tool", {{printf "%q" $tool.Name}},
		"mcp.subject", subj.Name,
		"outcome", "success",
		"duration_ms", time.Since(start).Milliseconds())
	return mcp.NewToolResultText("{{$tool.Name}}: ok"), nil
	{{- end}}
}
{{end}}

// recordOutcome increments the two tool-level counters for every
// terminated handler. Called from every exit path so metrics are
// complete even when the handler returns an error result.
func (t *Tools) recordOutcome(tool, subject, outcome string, start time.Time) {
	t.Metrics.ToolInvocations.WithLabelValues(tool, subject, outcome).Inc()
	t.Metrics.ToolDuration.WithLabelValues(tool, outcome).Observe(time.Since(start).Seconds())
}
