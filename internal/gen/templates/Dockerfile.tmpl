# syntax=docker/dockerfile:1.7
# {{.Server.Name}} — generated by mcp-go-gen.

FROM --platform=$BUILDPLATFORM golang:1.26-alpine AS build
WORKDIR /src

COPY go.mod go.sum ./
RUN go mod download

COPY . .

ARG TARGETOS TARGETARCH
RUN CGO_ENABLED=0 GOOS=${TARGETOS} GOARCH=${TARGETARCH} \
    go build -ldflags "-s -w" -o /out/{{.Server.Name}} ./cmd/{{.Server.Name}}

FROM gcr.io/distroless/static:nonroot
COPY --from=build /out/{{.Server.Name}} /usr/local/bin/{{.Server.Name}}
USER nonroot:nonroot
ENTRYPOINT ["/usr/local/bin/{{.Server.Name}}"]
